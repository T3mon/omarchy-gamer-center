#!/usr/bin/env python3
"""Gamer Center's Steam page: the library as one JSON object on stdout.

    gamercenter-steam [--root STEAM_ROOT]

Everything comes from Steam's own files; nothing is written and nothing
leaves the machine. Under the Steam root:

  steamapps/libraryfolders.vdf          every library folder
  <library>/steamapps/appmanifest_*     installed games and their size
  userdata/<id>/config/licensecache     the packages the account holds a live
                                        license for (see load_licenses)
  appcache/packageinfo.vdf              the apps in each package, so owned
                                        games that aren't installed show up
  appcache/appinfo.vdf                  each app's name, type and cover file
  appcache/librarycache/<appid>/        the covers Steam already downloaded
  userdata/<id>/config/localconfig.vdf  last played and time played
  userdata/<id>/config/cloudstorage/    the Favorites collection
  config/config.vdf                     a Proton version forced per game
  config/loginusers.vdf                 the account's name on Steam
  <library>/steamapps/compatdata/<id>/  the Proton version a game last ran with
  <library>/steamapps/workshop/         workshop mods: their size and count

With --deck APPID it prints that game's full Steam Deck report instead:
the three ratings (Steam Deck, Steam Machine, SteamOS), when and on which
build Valve tested it, every test result, and the configuration flags.

With --sizes it prints each installed game's Proton prefix and shader cache
size instead, which means walking those folders, so the panel asks for it
less often.

The VDF readers, the library list, the license cache and the package list
are ported from omarchy-quick-steam by Rysen Winters (MIT, see
licenses/omarchy-quick-steam.txt).

Every file is untrusted input: sizes are capped, a file that fails to parse
reads as empty, and only digits are accepted as app ids.
"""

import argparse
import glob
import json
import os
import re
import shutil
import struct
import sys
import zlib

MAX_TEXT = 64 * 1024 * 1024
MAX_BINARY = 256 * 1024 * 1024
MAX_LICENSES = 16 * 1024 * 1024
MAX_GAMES = 5000
MAX_DLC = 300
# EAppState bits in a manifest's StateFlags.
UPDATE_REQUIRED = 0x2
UPDATE_PAUSED = 0x200
UPDATING = 0x100 | 0x400 | 0x100000 | 0x200000 | 0x400000   # running, started, downloading, staging, committing
STEAMID64_BASE = 76561197960265728
APPID = re.compile(r"^[0-9]{1,10}$")
CONTROL = re.compile(r"[\x00-\x1f\x7f-\x9f]")


def steam_root():
    home = os.path.expanduser("~")
    for candidate in (
        os.path.join(home, ".steam/root"),
        os.path.join(home, ".local/share/Steam"),
        os.path.join(home, ".var/app/com.valvesoftware.Steam/.local/share/Steam"),
    ):
        if os.path.isfile(os.path.join(candidate, "config/config.vdf")):
            return os.path.realpath(candidate)
    return None


def read_file(path, limit):
    try:
        if os.path.getsize(path) > limit:
            return None
        with open(path, "rb") as handle:
            return handle.read()
    except OSError:
        return None


def as_int(value, default=0):
    try:
        return int(value)
    except (TypeError, ValueError):
        return default


def printable(value, limit=120):
    return CONTROL.sub(" ", value).strip()[:limit] if isinstance(value, str) else ""


# ---- Text VDF ---------------------------------------------------------------

TOKEN = re.compile(r'"((?:[^"\\]|\\.)*)"|([{}])|(//[^\n]*)|\s+', re.S)


def parse_text_vdf(text):
    """Nested dicts; later duplicate keys win. Keys keep their case."""
    root, stack, key = {}, [], None
    current = root
    for match in TOKEN.finditer(text):
        string, brace, comment = match.groups()
        if comment is not None or (string is None and brace is None):
            continue
        if brace == "{":
            node = {}
            if key is not None:
                current[key] = node
            stack.append(current)
            current, key = node, None
        elif brace == "}":
            current = stack.pop() if stack else root
            key = None
        elif key is None:
            key = string.replace('\\"', '"').replace("\\\\", "\\")
        else:
            current[key] = string.replace('\\"', '"').replace("\\\\", "\\")
            key = None
    return root


def load_text_vdf(path):
    data = read_file(path, MAX_TEXT)
    if data is None:
        return {}
    try:
        return parse_text_vdf(data.decode("utf-8", "replace"))
    except (IndexError, ValueError):
        return {}


def child(node, *names):
    """Case-insensitive descent through nested dicts; {} when a step is missing."""
    for name in names:
        if not isinstance(node, dict):
            return {}
        lowered = name.lower()
        node = next((value for key, value in node.items() if key.lower() == lowered), {})
    return node


# ---- Library folders --------------------------------------------------------

def mount_of(path):
    while not os.path.ismount(path) and path != "/":
        path = os.path.dirname(path)
    return path


def libraries(root):
    """Every Steam library folder, the Steam root first: its path, a short
    label, and the device it lives on."""
    found, seen = [], set()
    folders = load_text_vdf(os.path.join(root, "steamapps/libraryfolders.vdf"))
    entries = child(folders, "libraryfolders") or folders
    listed = [e for e in entries.values() if isinstance(e, dict)]
    labels = {child(e, "path"): child(e, "label") for e in listed if isinstance(child(e, "path"), str)}
    for path in [root] + [child(e, "path") for e in listed]:
        if not isinstance(path, str) or not path:
            continue
        real = os.path.realpath(path)
        if real in seen or not os.path.isdir(os.path.join(real, "steamapps")):
            continue
        seen.add(real)
        label = printable(labels.get(path), 40)
        if not label:
            mount = mount_of(real)
            label = "Steam" if real == root or mount == "/" else printable(os.path.basename(mount), 40) or "Steam"
        try:
            device = os.stat(real).st_dev
        except OSError:
            device = None
        found.append({"path": real, "label": label, "device": device})
    return found


def drives(libs, installed):
    """One entry per disk that holds a library: free and total space, and
    how much the installed games on it take."""
    out, by_device = [], {}
    for index, lib in enumerate(libs):
        key = lib["device"] if lib["device"] is not None else ("lib", index)
        if key not in by_device:
            try:
                stats = os.statvfs(lib["path"])
                free, total = stats.f_bavail * stats.f_frsize, stats.f_blocks * stats.f_frsize
            except OSError:
                free = total = 0
            by_device[key] = len(out)
            out.append({"label": lib["label"], "free": free, "total": total, "used": 0, "games": 0})
        lib["drive"] = by_device[key]
    for game in installed.values():
        drive = out[libs[game["library"]]["drive"]]
        drive["used"] += game["size"]
        drive["games"] += 1
    return out


# ---- Binary VDF (appinfo.vdf / packageinfo.vdf) -----------------------------

def read_cstring(buf, pos):
    end = buf.index(b"\0", pos)
    return buf[pos:end].decode("utf-8", "replace"), end + 1


def parse_binary_kv(buf, pos, strings=None, depth=0):
    if depth > 32:
        raise ValueError("too deep")
    out = {}
    while True:
        kind = buf[pos]
        pos += 1
        if kind == 0x08:
            return out, pos
        if strings is None:
            key, pos = read_cstring(buf, pos)
        else:
            (index,) = struct.unpack_from("<I", buf, pos)
            pos += 4
            key = strings[index]
        if kind == 0x00:
            out[key], pos = parse_binary_kv(buf, pos, strings, depth + 1)
        elif kind == 0x01:
            out[key], pos = read_cstring(buf, pos)
        elif kind in (0x02, 0x03, 0x04, 0x06):
            (out[key],) = struct.unpack_from("<f" if kind == 0x03 else "<i", buf, pos)
            pos += 4
        elif kind in (0x07, 0x0A):
            (out[key],) = struct.unpack_from("<Q" if kind == 0x07 else "<q", buf, pos)
            pos += 8
        else:
            raise ValueError("unknown type %#x" % kind)


SAFE_ASSET = re.compile(r"^(?:[0-9a-f]{40}/)?[A-Za-z0-9_.-]{1,80}\.(?:jpg|png)$")


def capsule_asset(common):
    """The portrait cover's file, relative to the app's librarycache folder:
    "<sha1>/library_capsule.jpg" for newer apps, "library_600x900.jpg" for
    older ones, or "" when appinfo doesn't name a safe one."""
    images = child(common, "library_assets_full", "library_capsule", "image")
    if isinstance(images, dict):
        value = images.get("english") or next(iter(images.values()), "")
        if isinstance(value, str) and SAFE_ASSET.match(value):
            return value
    return ""


def local_cover(root, appid, asset):
    """The cover Steam already downloaded for the app, or "". Nothing is
    fetched: a game Steam has no art for gets none."""
    base = os.path.join(root, "appcache/librarycache", str(appid))
    if not os.path.isdir(base):
        return ""
    for name in ([asset] if asset else []) + ["library_600x900.jpg"]:
        path = os.path.join(base, name)
        if os.path.isfile(path):
            return path
    for pattern in ("*/library_capsule.jpg", "*/library_600x900.jpg"):
        found = sorted(glob.glob(os.path.join(base, pattern)))
        if found:
            return found[0]
    return ""


def compat_rating(common, key):
    """A steam_deck_compatibility rating, 0..3. For "category" (Steam Deck):
    unknown, unsupported, playable, verified; for "steamos_compatibility":
    unknown, unsupported, compatible."""
    value = as_int(child(common, "steam_deck_compatibility", key))
    return value if 0 <= value <= 3 else 0


def appinfo_index(root):
    """(buf, strings, {appid: offset}) for appinfo.vdf (format 0x07564429 or
    0x07564428). A truncated or half-written file gives what was indexed
    before the damage."""
    buf = read_file(os.path.join(root, "appcache/appinfo.vdf"), MAX_BINARY)
    index, strings = {}, None
    if not buf or len(buf) < 16:
        return buf, strings, index
    magic = struct.unpack_from("<I", buf, 0)[0]
    pos = 8
    try:
        # Newer files keep every key in a string table at the end.
        if magic == 0x07564429:
            (table,) = struct.unpack_from("<q", buf, 8)
            (count,) = struct.unpack_from("<I", buf, table)
            strings, cursor = [], table + 4
            for _ in range(count):
                value, cursor = read_cstring(buf, cursor)
                strings.append(value)
            pos = 16
        elif magic != 0x07564428:
            return buf, strings, index
        while pos + 8 <= len(buf):
            appid, size = struct.unpack_from("<II", buf, pos)
            if appid == 0:
                break
            index[appid] = pos + 8 + 60
            pos += 8 + size
    except (ValueError, IndexError, struct.error):
        pass
    return buf, strings, index


def id_list(value):
    return [int(v) for v in str(value or "").split(",") if v.strip().isdigit()] if isinstance(value, str) else []


# What load_appinfo() gives an app it couldn't read.
NO_APP = {"name": "", "type": "", "asset": "", "deck": 0, "steamos": 0, "oslist": "", "dlc": [], "depots": {}, "workshop": False}


def app_entry(body):
    """One app's appinfo node, cut to what the page shows: name, type, cover
    asset, the Deck and SteamOS ratings, the platforms, the DLC ids, each
    depot's (DLC id, platforms), and whether it has a Workshop."""
    common = child(body, "common")
    depots = {}
    for depot, info in (child(body, "depots") or {}).items():
        if depot.isdigit() and isinstance(info, dict):
            depots[int(depot)] = (as_int(child(info, "dlcappid")), str(child(info, "config", "oslist") or ""))
    return {
        "name": printable(child(common, "name")),
        "type": str(child(common, "type")).lower(),
        "asset": capsule_asset(common),
        "deck": compat_rating(common, "category"),
        "steamos": compat_rating(common, "steamos_compatibility"),
        "oslist": str(child(common, "oslist") or ""),
        "dlc": id_list(child(body, "extended", "listofdlc"))[:MAX_DLC],
        "depots": depots,
        "workshop": str(child(common, "workshop_visible")) == "1",
    }


def load_appinfo(root, wanted, index=None):
    """{appid: app_entry()} for the app ids in wanted only."""
    buf, strings, offsets = index or appinfo_index(root)
    apps = {}
    for appid in wanted:
        if appid not in offsets:
            continue
        try:
            kv, _ = parse_binary_kv(buf, offsets[appid], strings)
            body = child(kv, "appinfo") or kv
            if child(body, "common"):
                apps[appid] = app_entry(body)
        except (ValueError, IndexError, struct.error, RecursionError):
            pass
    return apps


def load_owned(root, licenses=None):
    """App ids granted by the account's packages: every package cached in
    packageinfo.vdf, or only those in licenses when they are known. Package 0
    is Steam's own."""
    buf = read_file(os.path.join(root, "appcache/packageinfo.vdf"), MAX_BINARY)
    owned = set()
    if not buf or len(buf) < 8:
        return owned
    magic = struct.unpack_from("<I", buf, 0)[0]
    if magic not in (0x06565527, 0x06565528):
        return owned
    pos = 8
    try:
        while pos + 4 <= len(buf):
            (package,) = struct.unpack_from("<I", buf, pos)
            if package == 0xFFFFFFFF:
                break
            pos += 4 + 20 + 4 + (8 if magic == 0x06565528 else 0)
            kv, pos = parse_binary_kv(buf, pos)
            if package == 0 or (licenses is not None and package not in licenses):
                continue
            body = kv.get(str(package), kv)
            for value in (child(body, "appids") or {}).values():
                if as_int(value) > 0:
                    owned.add(as_int(value))
    except (ValueError, IndexError, struct.error):
        pass
    return owned


# ---- Licenses ---------------------------------------------------------------

# packageinfo.vdf caches every package the client ever looked at, refunded
# ones included. The license cache holds the real list: a
# CMsgClientLicenseList protobuf, XORed byte by byte with Valve's
# CUniformRandomStream (ran1 from Numerical Recipes, as in the Source SDK)
# seeded with the account id, one RandomInt(32, 126) per byte, and closed by
# the CRC32 of the rest. The format is undocumented, so anything unexpected
# falls back to packageinfo.vdf alone.
LICENSE_GONE = 0x08 | 0x10 | 0x20   # ELicenseFlags Expired, CancelledByUser, CancelledByAdmin


class UniformRandomStream:
    IA, IM, IQ, IR, NTAB = 16807, 2147483647, 127773, 2836, 32
    NDIV = 1 + (IM - 1) // NTAB
    MAX_RANDOM = 0x7FFFFFFF

    def __init__(self, seed):
        self.idum = seed if seed < 0 else -seed
        self.iy = 0
        self.iv = [0] * self.NTAB

    def _step(self):
        k = self.idum // self.IQ
        self.idum = self.IA * (self.idum - k * self.IQ) - self.IR * k
        if self.idum < 0:
            self.idum += self.IM

    def generate(self):
        if self.idum <= 0 or not self.iy:
            self.idum = 1 if -self.idum < 1 else -self.idum
            for j in range(self.NTAB + 7, -1, -1):
                self._step()
                if j < self.NTAB:
                    self.iv[j] = self.idum
            self.iy = self.iv[0]
        self._step()
        j = self.iy // self.NDIV
        self.iy = self.iv[j]
        self.iv[j] = self.idum
        return self.iy

    def random_int(self, low, high):
        span = high - low + 1
        limit = self.MAX_RANDOM - ((self.MAX_RANDOM + 1) % span)
        while True:
            value = self.generate()
            if value <= limit:
                return low + value % span


def read_varint(buf, pos):
    value = shift = 0
    while True:
        byte = buf[pos]
        pos += 1
        value |= (byte & 0x7F) << shift
        if byte < 0x80:
            return value, pos
        shift += 7
        if shift > 63:
            raise ValueError("varint too long")


def protobuf_fields(buf):
    """(field, wire type, value) for each field of one protobuf message:
    numbers as ints, length-delimited fields as bytes."""
    pos = 0
    while pos < len(buf):
        key, pos = read_varint(buf, pos)
        field, wire = key >> 3, key & 7
        if wire == 0:
            value, pos = read_varint(buf, pos)
        elif wire == 1:
            (value,) = struct.unpack_from("<Q", buf, pos)
            pos += 8
        elif wire == 5:
            (value,) = struct.unpack_from("<I", buf, pos)
            pos += 4
        elif wire == 2:
            size, pos = read_varint(buf, pos)
            if pos + size > len(buf):
                raise ValueError("truncated field")
            value, pos = buf[pos:pos + size], pos + size
        else:
            raise ValueError("wire type %d" % wire)
        yield field, wire, value


def scramble(data, account):
    """The license cache's XOR stream; applying it twice gives the input back."""
    stream = UniformRandomStream(account)
    return bytes(byte ^ stream.random_int(32, 126) for byte in data)


def load_licenses(root, user):
    """Package ids the account holds a live license for, or None when the
    license cache can't be read for certain (then every cached package counts)."""
    if not user or not user.isdigit():
        return None
    data = read_file(os.path.join(root, "userdata", user, "config/licensecache"), MAX_LICENSES)
    if not data or len(data) < 5:
        return None
    plain = scramble(data, int(user))
    body, (crc,) = plain[:-4], struct.unpack("<I", plain[-4:])
    if zlib.crc32(body) != crc:
        return None
    packages, found = set(), 0
    try:
        for field, wire, value in protobuf_fields(body):
            if field != 2 or wire != 2:
                continue
            package, flags = None, 0
            for inner, inner_wire, item in protobuf_fields(value):
                if inner == 1 and inner_wire == 0:
                    package = item
                elif inner == 7 and inner_wire == 0:
                    flags = item
            if package is None:
                continue
            found += 1
            if not flags & LICENSE_GONE:
                packages.add(package)
    except (ValueError, IndexError, struct.error):
        return None
    return packages if found else None


# ---- The account ------------------------------------------------------------

def current_user(root):
    """The userdata folder of the account that logged in last."""
    login = load_text_vdf(os.path.join(root, "config/loginusers.vdf"))
    users = child(login, "users") or {}
    best, best_time = None, -1
    for steamid, info in users.items():
        if not steamid.isdigit() or not isinstance(info, dict):
            continue
        stamp = as_int(child(info, "Timestamp"))
        if child(info, "MostRecent") == "1":
            stamp = 1 << 62
        if stamp > best_time:
            best, best_time = steamid, stamp
    if best:
        account = str(int(best) - STEAMID64_BASE)
        if account.isdigit() and os.path.isdir(os.path.join(root, "userdata", account)):
            return account
    dirs = [d for d in glob.glob(os.path.join(root, "userdata/*")) if os.path.basename(d).isdigit()]
    return os.path.basename(max(dirs, key=os.path.getmtime)) if dirs else None


def load_played(root, user):
    """{appid: (last played, minutes played, launch options)} from localconfig.vdf."""
    played = {}
    if not user:
        return played
    config = load_text_vdf(os.path.join(root, "userdata", user, "config/localconfig.vdf"))
    apps = child(config, "UserLocalConfigStore", "Software", "Valve", "Steam", "apps")
    for appid, info in (apps or {}).items():
        if APPID.match(appid) and isinstance(info, dict):
            played[int(appid)] = (max(0, as_int(child(info, "LastPlayed"))), max(0, as_int(child(info, "Playtime"))),
                                  printable(child(info, "LaunchOptions"), 500))
    return played


# ---- The library ------------------------------------------------------------

def game_folder(library_path, installdir):
    """steamapps/common/<installdir> when it is a plain folder name and exists, else ""."""
    if (not isinstance(installdir, str) or not 0 < len(installdir) <= 255 or "/" in installdir
            or installdir in (".", "..") or CONTROL.search(installdir)):
        return ""
    path = os.path.join(library_path, "steamapps/common", installdir)
    return path if os.path.isdir(path) and not os.path.islink(path) else ""


def update_state(state, workshop=None):
    """("" | "required" | "downloading" | "paused" | "mods", percent done)."""
    flags = as_int(child(state, "StateFlags"))
    build, target = as_int(child(state, "buildid")), as_int(child(state, "TargetBuildID"))
    total, done = as_int(child(state, "BytesToDownload")), as_int(child(state, "BytesDownloaded"))
    if flags & UPDATE_PAUSED:
        kind = "paused"
    elif flags & UPDATING:
        kind = "downloading"
    elif flags & UPDATE_REQUIRED or (target and target != build):
        kind = "required"
    elif child(workshop, "NeedsUpdate") == "1" or child(workshop, "NeedsDownload") == "1":
        kind = "mods"
    else:
        return ["", 0]
    percent = max(0, min(100, done * 100 // total)) if kind in ("downloading", "paused") and total > 0 else 0
    return [kind, percent]


def platform(appid, local, info, forced):
    """("linux" | "proton" | "windows" | "", the Proton build it last ran with).
    A game is native when an installed depot is for Linux; it runs through
    Proton when it has a prefix or a forced tool. Not installed: from its
    platform list."""
    info = info or NO_APP
    ran = ""
    if local:
        prefix = os.path.join(local["path"], "steamapps/compatdata", str(appid))
        version = read_file(os.path.join(prefix, "version"), 4096)
        if version:
            ran = printable(version.decode("utf-8", "replace").splitlines()[0] if version.strip() else "", 40)
            config = read_file(os.path.join(prefix, "config_info"), 64 * 1024)
            lines = config.decode("utf-8", "replace").splitlines() if config else []
            tool = lines[1].split("/files/")[0] if len(lines) > 1 and "/files/" in lines[1] else ""
            name = printable(os.path.basename(tool), 60)
            if name:
                ran = name + " " + ran if ran else name
        installed_os = [info["depots"].get(d, (0, ""))[1] for d in local["depots"]]
        if any("linux" in os_ for os_ in installed_os) and not forced:
            return "linux", ""
        if ran or forced or not any("linux" in os_ for os_ in installed_os):
            return "proton", ran
        return "", ""
    oslist = info["oslist"].split(",")
    if "linux" in oslist:
        return "linux", ""
    return ("windows", "") if "windows" in oslist else ("", "")


def forced_tools(root):
    """{appid: tool name} from config.vdf's CompatToolMapping. Entry 0 is the
    default for every game and isn't a per-game choice."""
    config = load_text_vdf(os.path.join(root, "config/config.vdf"))
    mapping = child(config, "InstallConfigStore", "Software", "Valve", "Steam", "CompatToolMapping")
    out = {}
    for appid, info in (mapping or {}).items():
        name = printable(child(info, "name"), 60) if isinstance(info, dict) else ""
        if APPID.match(appid) and appid != "0" and name:
            out[int(appid)] = name
    return out


def favorites(root, user):
    """App ids in the account's Favorites collection, from Steam's cloud
    storage cache; local edits not yet synced (.modified.json) win."""
    folder = os.path.join(root, "userdata", user or "", "config/cloudstorage")
    entry = None
    for name in ("cloud-storage-namespace-1.json", "cloud-storage-namespace-1.modified.json"):
        raw = read_file(os.path.join(folder, name), 16 * 1024 * 1024) if user else None
        try:
            pairs = json.loads(raw) if raw else []
        except ValueError:
            pairs = []
        for pair in pairs if isinstance(pairs, list) else []:
            if isinstance(pair, list) and len(pair) == 2 and pair[0] == "user-collections.favorite" and isinstance(pair[1], dict):
                entry = pair[1]
    if not entry or entry.get("is_deleted"):
        return set()
    try:
        value = json.loads(entry.get("value") or "{}")
    except (ValueError, TypeError):
        return set()
    added = value.get("added") if isinstance(value, dict) else None
    return {a for a in added if isinstance(a, int) and a > 0} if isinstance(added, list) else set()


def steam_status(root, pidfile, proc="/proc"):
    """{"running", "persona"}: Steam is running when its pid file names a
    live steam process; persona is the last account's name on Steam."""
    running = False
    raw = read_file(pidfile, 64) if pidfile else None
    pid = as_int(raw.decode("ascii", "replace").strip() if raw else "", 0)
    if pid > 0:
        comm = read_file(os.path.join(proc, str(pid), "comm"), 64)
        running = bool(comm) and comm.decode("utf-8", "replace").strip().startswith("steam")
    login = child(load_text_vdf(os.path.join(root, "config/loginusers.vdf")), "users")
    persona = ""
    for info in (login or {}).values():
        if isinstance(info, dict) and (child(info, "MostRecent") == "1" or not persona):
            persona = printable(child(info, "PersonaName"), 64) or persona
    return {"running": running, "persona": persona}


def dlc_list(appid, info, local, owned, names):
    """[{id, name, state}] for a game's DLC: "installed" (its depot is on
    disk), "owned" (bought; nothing to download, or not downloaded) or
    "missing" (not bought). Names come from appinfo; unnamed ones are left out."""
    if not info:
        return []
    depots = info["depots"]
    on_disk = set()
    if local:
        for depot, dlc in local["depots"].items():
            on_disk.add(dlc or depots.get(depot, (0, ""))[0])
    out = []
    for dlc in info["dlc"]:
        name = names.get(dlc, "")
        if not name:
            continue
        has_depot = any(d[0] == dlc for d in depots.values())
        state = "missing" if dlc not in owned else "installed" if local and has_depot and dlc in on_disk else "owned"
        out.append({"id": str(dlc), "name": name, "state": state})
    return out


DECK_RESULT = re.compile(r"^#(?:SteamDeckVerified|SteamMachine|SteamOS)_TestResult_([A-Za-z0-9_]{1,80})$")
DECK_KEY = re.compile(r"^[a-z0-9_]{1,60}$")


def deck_results(node):
    """[{result, display}] in Valve's order. display: 1 note, 2 fail, 3 warning, 4 pass."""
    out = []
    items = node.items() if isinstance(node, dict) else []
    for _, test in sorted(items, key=lambda kv: as_int(kv[0], 999)):
        m = DECK_RESULT.match(str(child(test, "token"))) if isinstance(test, dict) else None
        display = as_int(child(test, "display")) if isinstance(test, dict) else 0
        if m and 1 <= display <= 4:
            out.append({"result": m.group(1), "display": display})
    return out[:40]


def deck_report(root, appid):
    """The full steam_deck_compatibility block for one app, or None."""
    buf, strings, offsets = appinfo_index(root)
    if appid not in offsets:
        return None
    try:
        kv, _ = parse_binary_kv(buf, offsets[appid], strings)
    except (ValueError, IndexError, struct.error, RecursionError):
        return None
    deck = child(kv, "appinfo", "common", "steam_deck_compatibility") or child(kv, "common", "steam_deck_compatibility")
    if not deck:
        return None
    rating = lambda key: max(0, min(3, as_int(child(deck, key))))
    config = {}
    for key, value in (child(deck, "configuration") or {}).items():
        if DECK_KEY.match(key) and not isinstance(value, dict) and len(config) < 40:
            config[key] = printable(str(value), 60)
    build = as_int(child(deck, "tested_build_id"))
    return {
        "deck": rating("category"),
        "machine": rating("steam_machine_compatibility"),
        "steamos": rating("steamos_compatibility"),
        "testedAt": max(0, as_int(child(deck, "test_timestamp"))),
        "testedBuild": str(build) if build > 0 else "",
        "results": {
            "deck": deck_results(child(deck, "tests")),
            "machine": deck_results(child(deck, "steam_machine_tests")),
            "steamos": deck_results(child(deck, "steamos_tests")),
        },
        "config": config,
    }


def walk_size(path):
    """Bytes in the regular files under path, links not followed."""
    total, stack = 0, [path]
    while stack:
        try:
            with os.scandir(stack.pop()) as it:
                for e in it:
                    try:
                        if e.is_dir(follow_symlinks=False):
                            stack.append(e.path)
                        elif e.is_file(follow_symlinks=False):
                            total += e.stat(follow_symlinks=False).st_size
                    except OSError:
                        pass
        except OSError:
            pass
    return total


def extra_sizes(root):
    """{appid: [prefix bytes, shader cache bytes]} for the installed games."""
    out = {}
    for appid, game in installed_games(libraries(root)).items():
        base = os.path.join(game["path"], "steamapps")
        out[str(appid)] = [walk_size(os.path.join(base, "compatdata", str(appid))),
                           walk_size(os.path.join(base, "shadercache", str(appid)))]
    return out


def installed_games(libs):
    found = {}
    for index, lib in enumerate(libs):
        for manifest in sorted(glob.glob(os.path.join(lib["path"], "steamapps/appmanifest_*.acf"))):
            state = child(load_text_vdf(manifest), "AppState")
            appid = as_int(child(state, "appid"), -1)
            if appid <= 0 or appid in found:
                continue
            workshop = load_text_vdf(os.path.join(lib["path"], "steamapps/workshop/appworkshop_%d.acf" % appid))
            workshop = child(workshop, "AppWorkshop")
            depots = child(state, "InstalledDepots") or {}
            found[appid] = {
                "library": index,
                "path": lib["path"],
                "name": printable(child(state, "name")),
                "size": max(0, as_int(child(state, "SizeOnDisk"))),
                "lastPlayed": max(0, as_int(child(state, "LastPlayed"))),
                "folder": game_folder(lib["path"], child(state, "installdir")),
                "build": str(as_int(child(state, "buildid"))) if as_int(child(state, "buildid")) > 0 else "",
                "updated": max(0, as_int(child(state, "LastUpdated"))),
                "update": update_state(state, workshop),
                "depots": {int(d): as_int(child(v, "dlcappid")) for d, v in depots.items()
                           if d.isdigit() and isinstance(v, dict)},
                "workshop": max(0, as_int(child(workshop, "SizeOnDisk"))),
                "mods": len([k for k in (child(workshop, "WorkshopItemsInstalled") or {}) if k.isdigit()]),
            }
    return found


def library(root, pidfile=None):
    libs = libraries(root)
    installed = installed_games(libs)
    user = current_user(root)
    owned = load_owned(root, load_licenses(root, user))
    index = appinfo_index(root)
    appinfo = load_appinfo(root, owned | set(installed), index)
    played = load_played(root, user)
    forced = forced_tools(root)
    favorite = favorites(root, user)

    # Installed tools (Proton, runtimes, redistributables) aren't games.
    installed = {a: g for a, g in installed.items() if a not in appinfo or appinfo[a]["type"] == "game"}

    listed = sorted({a for a in owned if appid_is_game(appinfo, a)} | set(installed))
    # DLC names: the DLC entries of the listed games, parsed only now.
    dlc_ids = {d for a in listed if a in appinfo for d in appinfo[a]["dlc"]}
    names = {a: v["name"] for a, v in load_appinfo(root, dlc_ids, index).items()}

    games = []
    for appid in listed:
        local = installed.get(appid)
        info = appinfo.get(appid) or NO_APP
        name = info["name"] or (local or {}).get("name", "")
        if not name:
            continue
        last, minutes, options = played.get(appid, (0, 0, ""))
        if local and local["lastPlayed"] > last:
            last = local["lastPlayed"]
        kind, runs_with = platform(appid, local, appinfo.get(appid), forced.get(appid, ""))
        update = local["update"] if local else ["", 0]
        games.append({
            "id": str(appid),
            "name": name,
            "installed": local is not None,
            "library": local["library"] if local else -1,
            "size": local["size"] if local else 0,
            "lastPlayed": last,
            "playtime": minutes,
            "cover": local_cover(root, appid, info["asset"]),
            "deck": info["deck"],
            "steamos": info["steamos"],
            "hasWorkshop": info["workshop"],
            "folder": local["folder"] if local else "",
            "launchOptions": options,
            "build": local["build"] if local else "",
            "updated": local["updated"] if local else 0,
            "update": update[0],
            "progress": update[1],
            "workshop": local["workshop"] if local else 0,
            "mods": local["mods"] if local else 0,
            "platform": kind,
            "proton": runs_with,
            "forcedTool": forced.get(appid, ""),
            "favorite": appid in favorite,
            "dlc": dlc_list(appid, appinfo.get(appid), local, owned, names),
        })
        if len(games) >= MAX_GAMES:
            break

    disks = drives(libs, installed)
    for game in games:
        game["drive"] = libs[game["library"]]["drive"] if game["installed"] else -1
        del game["library"]
    games.sort(key=lambda g: g["name"].lower())
    return {"ok": True, "uwsm": shutil.which("uwsm-app") is not None, "drives": disks, "games": games,
            "steam": steam_status(root, pidfile)}


def appid_is_game(appinfo, appid):
    return appid in appinfo and appinfo[appid]["type"] == "game"


def main():
    parser = argparse.ArgumentParser(description="Print the Steam library as JSON")
    parser.add_argument("--root", help="the Steam folder to read (default: found under ~)")
    parser.add_argument("--sizes", action="store_true", help="print Proton prefix and shader cache sizes instead")
    parser.add_argument("--deck", metavar="APPID", help="print one game's full Steam Deck report instead")
    args = parser.parse_args()
    root = os.path.realpath(args.root) if args.root else steam_root()
    if not root or not os.path.isdir(os.path.join(root, "steamapps")):
        print(json.dumps({"ok": False, "error": "steam-not-found"}))
        return
    if args.deck is not None:
        if not APPID.match(args.deck):
            print(json.dumps({"ok": False, "error": "bad-appid"}))
            return
        report = deck_report(root, int(args.deck))
        print(json.dumps({"ok": True, "id": args.deck, "deck": report}, separators=(",", ":")))
        return
    if args.sizes:
        print(json.dumps({"ok": True, "sizes": extra_sizes(root)}, separators=(",", ":")))
        return
    # Steam's pid file sits in ~/.steam; a --root fixture keeps its own.
    pidfile = os.path.join(root, "steam.pid") if args.root else os.path.expanduser("~/.steam/steam.pid")
    print(json.dumps(library(root, pidfile), ensure_ascii=False, separators=(",", ":")))


if __name__ == "__main__":
    try:
        main()
    except Exception as error:  # Never hand the shell a traceback instead of JSON.
        print(json.dumps({"ok": False, "error": type(error).__name__}))
