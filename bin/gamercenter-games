#!/usr/bin/env python3
"""The other games on this PC for Gamer Center: every app-menu entry in the
Game category that isn't Steam's.

    gamercenter-games [--dirs DIR:DIR...]

Prints one JSON object:
    {"ok": true, "uwsm": bool, "games": [...]}
Each game is {"id", "name", "comment", "icon", "folder", "size"}. "id" is the
desktop entry id (rent-day.desktop), which is all the panel needs to launch it
(uwsm-app or gtk-launch); the entry's Exec line is never read as a command
here. "folder" is the entry's Path= and "size" the bytes under it, 0 when
there is no folder.

Entries are looked for where the app menu looks (XDG_DATA_HOME, XDG_DATA_DIRS
and Flatpak's exports); the first one found for an id wins, as in the menu.
"""

import json
import os
import re
import shutil
import sys

MAX_GAMES = 500
MAX_FILE = 64 * 1024
MAX_WALK = 200000
ID = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9 ._+-]{0,200}\.desktop$")
ICON_NAME = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9._+-]{0,200}$")
ICON_FILE = re.compile(r"\.(png|svg|jpg|jpeg|xpm)$", re.I)
CONTROL = re.compile(r"[\x00-\x1f\x7f-\x9f]")


def printable(value, limit):
    return " ".join(CONTROL.sub(" ", value or "").split())[:limit]


def data_dirs(env=os.environ):
    home = env.get("HOME") or os.path.expanduser("~")
    first = env.get("XDG_DATA_HOME") or os.path.join(home, ".local/share")
    rest = (env.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":")
    out = []
    for d in [first, os.path.join(home, ".local/share/flatpak/exports/share")] + rest + ["/var/lib/flatpak/exports/share"]:
        if d and os.path.isabs(d) and d not in out:
            out.append(d)
    return [os.path.join(d, "applications") for d in out]


def entry(path):
    """The [Desktop Entry] group's keys, localized ones left out."""
    try:
        with open(path, "rb") as f:
            raw = f.read(MAX_FILE + 1)
    except OSError:
        return None
    if len(raw) > MAX_FILE:
        return None
    keys, group = {}, None
    for line in raw.decode("utf-8", "replace").splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("["):
            group = line
            continue
        if group != "[Desktop Entry]" or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        if "[" not in key and key not in keys:
            keys[key] = value.strip()
    return keys


def true(value):
    return (value or "").lower() == "true"


def runnable(program):
    if not program:
        return True
    if os.path.isabs(program):
        return os.access(program, os.X_OK)
    return shutil.which(program) is not None


def is_steam(desktop_id, keys):
    """Steam itself and the shortcuts Steam makes: those games are on the Steam tabs."""
    run = keys.get("Exec", "")
    first = run.split()[0] if run.split() else ""
    return desktop_id == "steam.desktop" or "steam://" in run or os.path.basename(first) == "steam"


def is_game(desktop_id, keys):
    return (keys is not None and keys.get("Type") == "Application"
            and "Game" in keys.get("Categories", "").split(";")
            and not true(keys.get("NoDisplay")) and not true(keys.get("Hidden"))
            and bool(printable(keys.get("Name"), 120))
            and runnable(keys.get("TryExec"))
            and not is_steam(desktop_id, keys))


def icon(value):
    value = (value or "").strip()
    if os.path.isabs(value):
        real = os.path.realpath(value)
        return real if ICON_FILE.search(real) and os.path.isfile(real) and not CONTROL.search(real) else ""
    return value if ICON_NAME.match(value) else ""


def folder(value, home):
    """Path=, when it is a real folder that isn't /, home or above home."""
    value = (value or "").strip()
    if not os.path.isabs(value) or CONTROL.search(value):
        return ""
    real = os.path.realpath(value)
    if not os.path.isdir(real) or real == "/" or os.path.realpath(home).startswith(real.rstrip("/") + "/") \
            or real == os.path.realpath(home):
        return ""
    return real


def size(path):
    """Bytes in the regular files under path, links not followed."""
    total, seen, stack = 0, 0, [path]
    while stack and seen < MAX_WALK:
        try:
            with os.scandir(stack.pop()) as it:
                for e in it:
                    seen += 1
                    try:
                        if e.is_dir(follow_symlinks=False):
                            stack.append(e.path)
                        elif e.is_file(follow_symlinks=False):
                            total += e.stat(follow_symlinks=False).st_size
                    except OSError:
                        pass
        except OSError:
            pass
    return total


def entries(apps_dir):
    """(desktop id, path) under one applications folder; subfolders join with "-"."""
    out = []
    for parent, dirs, files in os.walk(apps_dir):
        dirs.sort()
        for name in sorted(files):
            if name.endswith(".desktop"):
                rel = os.path.relpath(os.path.join(parent, name), apps_dir)
                out.append((rel.replace(os.sep, "-"), os.path.join(parent, name)))
    return out


def scan(dirs, home):
    games, seen = [], set()
    for apps in dirs:
        for desktop_id, path in entries(apps):
            if desktop_id in seen:
                continue
            seen.add(desktop_id)  # the first entry for an id hides the later ones
            if not ID.match(desktop_id):
                continue
            keys = entry(path)
            if not is_game(desktop_id, keys):
                continue
            where = folder(keys.get("Path"), home)
            games.append({
                "id": desktop_id,
                "name": printable(keys.get("Name"), 120),
                "comment": printable(keys.get("Comment"), 200),
                "icon": icon(keys.get("Icon")),
                "folder": where,
                "size": size(where) if where else 0,
            })
            if len(games) >= MAX_GAMES:
                return games
    return games


def main(argv):
    dirs = data_dirs()
    if len(argv) == 2 and argv[0] == "--dirs":
        dirs = [d for d in argv[1].split(":") if os.path.isabs(d)]
    home = os.environ.get("HOME") or os.path.expanduser("~")
    out = {"ok": True, "uwsm": shutil.which("uwsm-app") is not None, "games": scan(dirs, home)}
    print(json.dumps(out, ensure_ascii=False, separators=(",", ":")))


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except Exception as error:  # Never hand the shell a traceback instead of JSON.
        print(json.dumps({"ok": False, "error": type(error).__name__}))
